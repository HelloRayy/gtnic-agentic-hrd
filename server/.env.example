# Server Environment Variables
PORT=5000
NODE_ENV=development

# 9router / OpenRouter / LLM Gateway Credentials
# Supports OpenRouter, 9router, or direct OpenAI-compatible endpoint
ROUTER_API_KEY=your_router_api_key_here
ROUTER_BASE_URL=https://openrouter.ai/api/v1
ROUTER_MODEL=google/gemini-2.0-flash-001

# Optional Direct Gemini API Key
GEMINI_API_KEY=

# GitHub Personal Access Token (for higher API rate limit when auditing repos)
GITHUB_TOKEN=
